# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings > API. The reporting platform and the Hub share one project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Locally http://localhost:3000; in production your deployed URL.
NEXT_PUBLIC_SITE_URL=

# ── Africa's Talking ────────────────────────────────────────────────────────
# USSD confirmation SMS, sent by /api/ussd/events when a session ends.
# Sandbox: username "sandbox" plus the sandbox API key.
# Leave unset to disable SMS — the USSD report still saves.
AT_USERNAME=
AT_API_KEY=

# ── OpenRouter ──────────────────────────────────────────────────────────────
# Powers the in-app resource assistant (/api/chat). Leave unset to disable it.
OPENROUTER_API_KEY=
# Optional; defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=

# ── Meta (online listening) ─────────────────────────────────────────────────
# Facebook Page monitoring. Leave unset to disable the feature;
# /hub/reporting/listening then shows a "not connected" state.
#
# Note: an App ID and App Secret from the Meta dashboard are NOT enough on
# their own. Those give an *app* access token, which cannot read a Page feed.
# META_PAGE_ACCESS_TOKEN must be a long-lived *Page* token — see SETUP.md.
# "Test connection" on the listening page reports exactly which part is missing.
# META_APP_ID is optional but recommended: with it, "Test connection" can also
# report the token's scopes and how long it has left before expiring.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# ── Legacy ──────────────────────────────────────────────────────────────────
# The standalone reporting deployment. No longer used for navigation — the
# reporting platform is part of this app. Safe to remove once it is retired.
NEXT_PUBLIC_REPORTING_URL=
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# ── Social link listening ──────────────────────────────────────────────────
# Instagram posts are read through Apify; X posts through X's public embed (no key).
# APIFY_TOKEN=
# SOCIAL_DAILY_CAP=60
# SOCIAL_PROVIDER=off   # kill switch

TYPESAFE_API_KEY=
# ── Urgent-case alerts ─────────────────────────────────────────────────────
# Web push (generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tech@whrdhub.org
# Second-line recipients for cases nobody acknowledged (comma-separated emails)
# ESCALATION_EMAILS=
# Protects /api/cron/escalate-reports (Vercel sends it as a Bearer token)
# CRON_SECRET=
# Mailtrap token for escalation emails
# MAILTRAP_SENDING_TOKEN=

# ── Map tiles ──────────────────────────────────────────────────────────────
# CARTO Voyager basemap key for the incident map. Without it the map falls back to the keyless light style.
# NEXT_PUBLIC_CARTO_API_KEY=
